pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
srandnum = rnd(32489)

function _init()
		srand(srandnum)
		room_init()
		game_over=false
end

function _draw()
    cls()
   	room_gen()
    print_tiles()
   	if btn(➡️) then
   		srandnum += 1
	    clear_tiles()
	    _init(srandnum)
	  		room_gen()
     print_tiles()             
    end
    if btn(⬅️) then
   		srandnum -= 1
	    clear_tiles()
	    _init(srandnum)
	  		room_gen()
     print_tiles()             
    end
    
				map(0, 0, 0, 0, 16, 16)
				rectfill(0,0,19,5, 0)
				print(flr(srandnum), 7)
				
end

-->8

tiles = {
{left=true, up=false, right=true, down=false, id=001}, -- horizonal straight
{left=false, up=true, right=false, down=true, id=002}, -- vertical straight
		
{left=false, up=true, right=true, down=false, id=003}, -- up-right corner
{left=true, up=true, right=false, down=false, id=004}, -- up-left corner
{left=false, up=false, right=true, down=true, id=005}, -- down-right corner
{left=true, up=false, right=false, down=true, id=006}, -- down-left corner
		
{left=true, up=true, right=false, down=true, id=007}, -- left t
{left=true, up=true, right=true, down=false, id=008}, -- up t
{left=false, up=true, right=true, down=true, id=009}, -- right t
{left=true, up=false, right=true, down=true, id=010}, -- down t
		
{left=true, up=true, right=true, down=true, id=011}, -- cross
}

end_tiles = {
{left=true, up=false, right=false, down=false, id=012}, -- end left
{left=false, up=true, right=false, down=false, id=013}, -- end up
{left=false, up=false, right=true, down=false, id=014}, -- end right
{left=false, up=false, right=false, down=true, id=015} -- end down
}

function get_conditions(x, y)

				if fget(mget(x-1,y), 2) then
    		left_condition = "connected"           
    elseif fget(mget(x-1,y), 4) then
    		left_condition = "nothing"		
    else
    		left_condition = "blocked"
    end
	
				if fget(mget(x,y-1), 3) then
    		up_condition = "connected"           
    elseif fget(mget(x,y-1), 4) then
    		up_condition = "nothing"		
    else
    		up_condition = "blocked"
    end
	
				if fget(mget(x+1,y), 0) then
    		right_condition = "connected"           
    elseif fget(mget(x+1,y), 4) then
    		right_condition = "nothing"		
    else
    		right_condition = "blocked"
    end
	
				if fget(mget(x,y+1), 1) then
    		down_condition = "connected"           
    elseif fget(mget(x,y+1), 4) then
    		down_condition = "nothing"		
    else
    		down_condition = "blocked"
    end
    
    return {
      left_condition, 
      up_condition, 
      right_condition, 
      down_condition
    }
end
-->8


function print_tiles()
	for i=0, 15 do
	   for j=0, 15 do
					 x = i
					 y = j
					 
					 if fget(mget(x,y), 5) then
    				goto continue
						end -- future room gen
	    	
					 if game_over == true then
						  x = 99
						  y = 99
				  end
				         
				  conditions = get_conditions(x, y)
				  
					 selected_tiles = {}
								 
					 for i, tile in ipairs(tiles) do
							 local left_match = (conditions[1] == "connected" and tile.left == true) or (conditions[1] == "blocked" and tile.left == false) or (conditions[1] == "nothing")
							 local up_match = (conditions[2] == "connected" and tile.up == true) or (conditions[2] == "blocked" and tile.up == false) or (conditions[2] == "nothing")
							 local right_match = (conditions[3] == "connected" and tile.right == true) or (conditions[3] == "blocked" and tile.right == false) or (conditions[3] == "nothing")
							 local down_match = (conditions[4] == "connected" and tile.down == true) or (conditions[4] == "blocked" and tile.down == false) or (conditions[4] == "nothing")
									
							 if left_match and up_match and right_match and down_match then
							   add(selected_tiles, tile.id) -- assuming each tile has an 'id'
							 end
					 end	
					 
					 if selected_tiles[1] == nil then
					 		for i, tile in ipairs(end_tiles) do
									 local left_match = (conditions[1] == "connected" and tile.left == true) or (conditions[1] == "blocked" and tile.left == false) or (conditions[1] == "nothing")
									 local up_match = (conditions[2] == "connected" and tile.up == true) or (conditions[2] == "blocked" and tile.up == false) or (conditions[2] == "nothing")
									 local right_match = (conditions[3] == "connected" and tile.right == true) or (conditions[3] == "blocked" and tile.right == false) or (conditions[3] == "nothing")
									 local down_match = (conditions[4] == "connected" and tile.down == true) or (conditions[4] == "blocked" and tile.down == false) or (conditions[4] == "nothing")
												
									 if left_match and up_match and right_match and down_match then
									   add(selected_tiles, tile.id) -- assuming each tile has an 'id'
									 end
					 			end
					 	end
					   
						mset(x, y, selected_tiles[ceil(rnd(#selected_tiles))])
						::continue::	
				end
		end
		game_over=true
		
end



function clear_tiles()
		cls()
	 for i=0, 15 do
		 	for j=0,15 do
    		mset(i,j,000)
    end
  end
end
-->8
function room_init()
		rx = rnd(8)+3
		ry = rnd(8)+3
		rndx = ceil(rnd(4)+1)
		rndy = ceil(rnd(4)+1)
		rnd4 = ceil(rnd(9))
		
		rndxr = rnd(rndx-2)+1
		rndyr = rnd(rndy-2)+1
end

function room_gen()
		mset(rx, ry, 021)
		
		for i=1, rndx do
				for j=1, rndy do
						mset(rx+i, ry+j, 029)	
				end
		end
		
		for i=1, rndx do
				mset(rx+i, ry, 017)	
		end
			
		for i=1, rndy do
				mset(rx, ry+i, 018)	
		end
		
		for i=1, rndx do
				mset(rx+i, ry+rndy, 019)	
		end
			
		for i=1, rndy do
				mset(rx+rndx, ry+i, 020)	
		end
		
		mset(rx, ry+rndy, 022)
		mset(rx+rndx, ry, 023)
		mset(rx+rndx, ry+rndy, 024)
		
		if rnd4 == 1 then
			mset(rx, ry+rndyr, 025)
		elseif rnd4 == 2 then
			mset(rx+rndxr, ry, 026)
		elseif rnd4 == 3 then
			mset(rx+rndx, ry+rndyr, 027)
		elseif rnd4 == 4 then
			mset(rx+rndxr, ry+rndy, 028)
		elseif rnd4 == 5 then
			mset(rx, ry+rndyr, 025)
			mset(rx+rndxr, ry, 026)
			mset(rx+rndx, ry+rndyr, 027)
			mset(rx+rndxr, ry+rndy, 028)
		elseif rnd4 == 6 then
			mset(rx, ry+rndyr, 025)
			mset(rx+rndx, ry+rndyr, 027)
		elseif rnd4 == 7 then
			mset(rx+rndxr, ry, 026)
			mset(rx+rndxr, ry+rndy, 028)
		elseif rnd4 == 8 then
			mset(rx, ry+rndyr, 025)
			mset(rx+rndxr, ry, 026)
		elseif rnd4 == 9 then
			mset(rx+rndx, ry+rndyr, 027)
			mset(rx+rndxr, ry+rndy, 028)
		end
end
